{
  "name": "fitline",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "analyze:size": "node scripts/measure-bundles.mjs",
    "seo:check": "node scripts/check-seo.mjs"
  },
  "dependencies": {
    "@serwist/next": "^9.5.13",
    "axios": "^1.21.0",
    "dayjs": "^1.11.23",
    "framer-motion": "^14.10.1",
    "jalaliday": "^3.1.1",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-intersection-observer": "^11.0.1",
    "react-spinners": "^0.17.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "serwist": "^9.5.13",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    },
    "@serwist/build": {
      "glob": "^14.0.2"
    },
    "@serwist/next": {
      "glob": "^14.0.2"
    },
    "zod": "^4.6.7"
  }
